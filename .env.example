# Copy to .env.local. Values for the local stack are printed by `npx supabase status`.
# Only browser-safe values belong here: never put an sb_secret_ key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Contact shown on the "Données et confidentialité" page (optional).
NEXT_PUBLIC_CONTACT_EMAIL=
